{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
   "allowImportingTsExtensions":true,
   "types":["node"],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": false,
    "outDir": "dist",
   "typeRoots": ["./node_modules/@types"] 
  }
}
